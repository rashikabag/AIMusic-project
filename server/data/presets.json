  "presets": [
    {
      "id": "thriller-bass",
      "name": "Thriller Bass",
      "year": 1982,
      "artist": "Michael Jackson",
      "producer": "Quincy Jones",
      "hardware": "Moog Minimoog Model D",
      "era": "1970s-analog",
      "track": "bass",
      "description": "Quincy Jones layered a tight, percussive Moog bass under 'Thriller' to anchor the groove without muddying the kick. Short filter envelopes created that iconic punch.",
      "targets": {
        "waveform": "sawtooth",
        "frequency": 55,
        "cutoff": 420,
        "resonance": 3.5,
        "stutterRate": 0
      },
      "tolerances": {
        "frequency": 12,
        "cutoff": 80,
        "resonance": 1.5,
        "stutterRate": 0
      },
      "steps": [
        {
          "id": "waveform",
          "field": "waveform",
          "target": "sawtooth",
          "instruction": "Step 1: Set the waveform to Sawtooth \u2014 the raw harmonic stack Moog oscillators are famous for.",
          "theory": "Sawtooth waves contain every integer harmonic, giving analog bass its 'buzz' before filtering shapes the tone."
        },
        {
          "id": "frequency",
          "field": "frequency",
          "target": 55,
          "instruction": "Step 2: Tune frequency near 55 Hz (A1) \u2014 the sub-fundamental Quincy locked to the kick.",
          "theory": "Placing bass an octave below the root leaves headroom for vocals and guitars in the midrange."
        },
        {
          "id": "cutoff",
          "field": "cutoff",
          "target": 420,
          "instruction": "Step 3: Drag Cutoff below 500 Hz to shave harsh highs and reveal warm body.",
          "theory": "Excellent. By lowering the cutoff, you removed brittle upper harmonics, leaving the sub-heavy fundamental Jones used on Thriller."
        },
        {
          "id": "resonance",
          "field": "resonance",
          "target": 3.5,
          "instruction": "Step 4: Add slight Resonance (~3.5) for a vocal 'wah' peek at the filter sweet spot.",
          "theory": "A modest resonance bump emphasizes the cutoff frequency \u2014 the classic Moog 'squelch' without whistling."
        }
      ],
