    {
      "id": "808-sub",
      "name": "808 Sub",
      "year": 1983,
      "artist": "Afrika Bambaataa / Marvin Gaye lineage",
      "producer": "Various (Roland TR-808)",
      "hardware": "Roland TR-808 Bass Drum Circuit",
      "era": "1980s-roland",
      "track": "bass",
      "description": "The TR-808 bass drum was never meant to be a sub-bass instrument \u2014 but hip-hop and electro producers discovered its long decay tail could carry an entire track's low end.",
      "targets": {
        "waveform": "sine",
        "frequency": 50,
        "cutoff": 180,
        "resonance": 1,
        "stutterRate": 0
      },
      "tolerances": {
        "frequency": 10,
        "cutoff": 60,
        "resonance": 1,
        "stutterRate": 0
      },
      "steps": [
        {
          "id": "waveform",
          "field": "waveform",
          "target": "sine",
          "instruction": "Step 1: Select Sine wave \u2014 the pure tone of the 808's resonant bridged-T network.",
          "theory": "A sine has no overtones; it's the cleanest sub foundation for club systems."
        },
        {
          "id": "frequency",
          "field": "frequency",
          "target": 50,
          "instruction": "Step 2: Set frequency around 50 Hz for chest-rattling sub.",
          "theory": "808 kicks often sit between 45\u201360 Hz depending on sample decay and pitch sweep."
        },
        {
          "id": "cutoff",
          "field": "cutoff",
          "target": 180,
          "instruction": "Step 3: Cutoff below 200 Hz \u2014 isolate only sub energy.",
          "theory": "Rolling off everything above 200 Hz keeps the 808 from fighting snares and hi-hats."
        },
        {
          "id": "resonance",
          "field": "resonance",
          "target": 1,
          "instruction": "Step 4: Keep Resonance low (~1) for a soft, rounded 808 bloom.",
          "theory": "The original 808 circuit had gentle resonance \u2014 too much sounds like a synth, not a drum."
        }
      ],
