    {
      "id": "909-kick",
      "name": "909 Kick",
      "year": 1984,
      "artist": "Frankie Knuckles / Daft Punk lineage",
      "producer": "Chicago House / French Touch",
      "hardware": "Roland TR-909",
      "era": "1980s-roland",
      "track": "fx",
      "description": "The TR-909 kick is punchier and more 'clicky' than the 808 \u2014 the backbone of house, techno, and rave. Its pitch sweep and short attack cut through dense mixes.",
      "targets": {
        "waveform": "triangle",
        "frequency": 62,
        "cutoff": 320,
        "resonance": 2,
        "stutterRate": 0
      },
      "tolerances": {
        "frequency": 15,
        "cutoff": 100,
        "resonance": 1.5,
        "stutterRate": 0
      },
      "steps": [
        {
          "id": "waveform",
          "field": "waveform",
          "target": "triangle",
          "instruction": "Step 1: Choose Triangle \u2014 approximates the 909's pitched oscillator sweep attack.",
          "theory": "Triangle waves are brighter than sine but softer than square \u2014 ideal for punchy kicks."
        },
        {
          "id": "frequency",
          "field": "frequency",
          "target": 62,
          "instruction": "Step 2: Frequency near 62 Hz for a tight four-on-the-floor thump.",
          "theory": "909 kicks typically tune higher than 808s for dancefloor clarity on smaller speakers."
        },
        {
          "id": "cutoff",
          "field": "cutoff",
          "target": 320,
          "instruction": "Step 3: Cutoff around 300 Hz preserves click while trimming mud.",
          "theory": "House producers leave a little mid 'click' so kicks translate on laptop speakers."
        },
        {
          "id": "stutter",
          "field": "stutterRate",
          "target": 0,
          "instruction": "Step 4: Stutter Rate at 0 \u2014 a 909 kick is a single transient, not a gated effect.",
          "theory": "Unlike FX tracks, classic 909 patterns rely on grid placement, not stutter."
        }
      ],
