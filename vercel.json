{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/client",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/historical-presets", "destination": "/api/historical-presets" },
    { "source": "/generate-loop", "destination": "/api/generate-loop" }
  ],
  "functions": {
    "api/generate-loop.ts": {
      "maxDuration": 10
    }
  }
}
